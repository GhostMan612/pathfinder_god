# ─── Pathfinder God: keep the big data + secrets out of git ───────────────

# The 500MB+ rules databases live ONLY on the laptop hub. Never commit them.
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.db.bak
*.sqlite
*.sqlite3
# ...but DO keep the schema doc and any tiny test fixtures we ship on purpose
!hub/tests/fixtures/*.db
# ...and the device rulebook extract (Git LFS, ships inside the APK)
!spoke_kt/app/src/main/assets/rules/pathfinder_rag.db

# Secrets / local config
.env
.env.*
!.env.example
*.key
*.keystore
*.jks
google-services.json
SPEC_SHEET*
data/*.pdf
# Session working docs (never pushed by workflow law)
blueprints/
_archive/
# Agent tooling — TRACKED, because the doctrine is the product here.
# RULES.md §1A, the gate tools, and the agent definitions are the workflow.
# A clone with no `.opencode/` gets prose that references files that aren't there
# and gates that aren't installed. Commit the doctrine; ignore only runtime bloat.
.opencode/node_modules/
.opencode/package-lock.json
.opencode/bun.lock
.opencode/.env*
.opencode/tmp/
# Machine-local scratch, if any is ever added
.opencode/logs/
.opencode/*.log
# NOTE: `.opencode/opencode.json` and `.opencode/.gitignore` ARE tracked
# deliberately — opencode.json holds the permission denies that enforce §1A.

# Campaign save files (runtime state, per-user)
data/campaign_state*.json

# Command Center runtime logs
tools/command_center/logs/
tools/command_center/chat_history.json

# Fetched upstream data (large, reproducible via hub/scripts builders)
hub/scripts/external/
# Scraper resume checkpoints + probe measurements (local tuning state)
hub/scripts/checkpoints/
# ─── Python (hub) ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ─── Flutter / Dart (spoke) ───────────────────────────────────────────────
spoke/.dart_tool/
spoke/.flutter-plugins
spoke/.flutter-plugins-dependencies
spoke/.packages
spoke/build/
spoke/.pub-cache/
spoke/.pub/
spoke/android/.gradle/
spoke/android/app/build/
spoke/android/local.properties
spoke/android/key.properties
spoke/*.iml
spoke/ios/Pods/
spoke/ios/.symlinks/

# Native Kotlin Spoke (spoke_kt)
spoke_kt/.gradle/
spoke_kt/.kotlin/
spoke_kt/build/
spoke_kt/app/build/
spoke_kt/local.properties
spoke_kt/*.iml
spoke_kt/gradle/gradle-daemon-jvm.properties

# ─── Editors / OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
