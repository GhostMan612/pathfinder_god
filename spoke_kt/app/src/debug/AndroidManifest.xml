<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!--
          Host for the Compose UI tests, launched explicitly by every test in the a11y package
          via createAndroidComposeRule<ComposeTestActivity>().

          It is declared here, in the app APK under the default process, because that is what
          createAndroidComposeRule<YourActivity>() requires. src/androidTest is wrong: an
          activity declared there lands in the instrumentation APK, ActivityScenario resolves
          it against the test process, and the launch fails.

          The theme is a plain platform theme. AppCompat themes throw on window creation for a
          host that is not an AppCompatActivity, and the tests do not need one - Compose
          theming comes from PathfinderGodTheme inside setContent, not from the XML theme.
        -->
        <activity
            android:name="com.pathfindergod.spoke.a11y.ComposeTestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

    </application>

</manifest>