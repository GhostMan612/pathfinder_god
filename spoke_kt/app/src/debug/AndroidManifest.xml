<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!--
          Host for the Compose UI tests. Debug-only, so it never reaches a shippable
          build.

          androidx.activity.ComponentActivity comes from ui-test-manifest via
          `debugImplementation`, which puts it in the APPLICATION manifest where it
          inherits Theme.PathfinderGod -> Theme.AppCompat. It launches, but the
          ComposeTestRule never registers a Compose root and every test fails with
          "No compose hierarchies found in the app" - including a minimal
          `setContent { Text("smoke") }`, which rules out the design system and the
          AGDK GameActivity.

          It cannot be declared in src/androidTest either: that lands it in the
          instrumentation APK, and the rule then fails with "Intent in process
          com.pathfindergod.spoke resolved to different process
          com.pathfindergod.spoke.test". src/debug satisfies both constraints.

          The theme is a plain platform theme. AppCompat themes throw on window
          creation for a host that is not an AppCompatActivity, and the tests do not
          need one: the Compose theming comes from the PathfinderGodTheme composable
          called inside setContent, not from the XML theme.
        -->
        <activity
            android:name="com.pathfindergod.spoke.a11y.ComposeTestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

    </application>

</manifest>